rules_version = '2';

// Multi-character model: /users/{uid}/characters/{charId}
//   read:  public  — anyone with the share link can view (storyteller view)
//   write: owner only — request.auth.uid must equal the path uid
//
// Deploy: Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/characters/{charId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy single-character docs from the prototype (kept readable during
    // the migration window; remove once all clients are on the new model).
    match /characters/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
