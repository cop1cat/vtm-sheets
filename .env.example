# Cloud config (public Firebase web config — safe to expose, NOT secret).
# Copy to .env.local for local dev, or set as CI secrets for deploy.
# Leave unset to run the app fully local/offline (no sign-in, no sync).
#
# Get these from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base path for the deployed site. For a GitHub *project* page
# (https://<user>.github.io/vtm-sheets/) set "/vtm-sheets/".
# For a user page or custom domain, leave as "/".
# VITE_BASE=/vtm-sheets/
